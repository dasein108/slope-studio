#!/usr/bin/env bash
# Slope Studio commit guardrail (SLO-33) — blocks secrets from entering git history.
# Applies to EVERY commit in this repo once activated (scripts/install-hooks.sh sets
# core.hooksPath=scripts/hooks), including autonomous agents.
# Humans may override with `git commit --no-verify`; agents MUST NOT.

# 0) Block direct commits to main/master — agents must use a feature branch (SLO-33).
branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo "BLOCKED: direct commits to '$branch' are not allowed (SLO-33) — use a feature branch." >&2
  echo "Humans only: git commit --no-verify." >&2
  exit 1
fi

fail=0

# 1) Block secret-bearing FILENAMES being added/modified.
files=$(git diff --cached --name-only --diff-filter=AM)
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    *token*.json|*token*.bak|*.json.bak|*client_secret*.json|.env|*/.env|*.pem|*id_rsa*)
      echo "BLOCKED: secret-bearing file staged -> $f" >&2; fail=1;;
  esac
done <<< "$files"

# 2) Block secret VALUE patterns in staged additions.
pat='ya29\.[0-9A-Za-z_-]{15,}|1//[0-9A-Za-z_-]{30,}|GOCSPX-[0-9A-Za-z_-]{15,}|gh[pousr]_[0-9A-Za-z]{30,}|sk-(proj-)?[0-9A-Za-z_-]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[0-9A-Za-z-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
added=$(git diff --cached -U0 --no-color 2>/dev/null | grep -E '^\+' || true)
hits=$(printf '%s\n' "$added" | grep -EIon "$pat" || true)
if [ -n "$hits" ]; then
  echo "BLOCKED: staged content matches a secret pattern:" >&2
  printf '%s\n' "$hits" | head -5 >&2
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "pre-commit secret guardrail (SLO-33) blocked this commit." >&2
  echo "Unstage/remove the secret. Humans only: git commit --no-verify (agents MUST NOT)." >&2
  exit 1
fi
exit 0
